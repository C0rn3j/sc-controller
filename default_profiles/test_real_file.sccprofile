{
    "_": "",
    "buttons": {
        "A": {
            "action": "hold(mode(LB, name('Use+Item Use (LB+Hold)', press(button(Keys.KEY_BACKSPACE)); button(Keys.KEY_LEFTALT); release(button(Keys.KEY_BACKSPACE))), None), mode(LB, name('Activate Item (LB)', button(Keys.KEY_ENTER)), None))"
        },
        "B": {
            "action": "hold(mode(Y, button(Keys.KEY_LEFTCTRL), LB, name('Lean Right', button(Keys.KEY_RIGHTBRACE)), LT >= 0.01, name('Firemode (Weapon zoom)', button(Keys.KEY_EQUAL)), name('Medkit (Hold)', button(Keys.KEY_W))), mode(LB, name('Cycle Inv. Right (LB)', button(Keys.KEY_RIGHT)), name('Bandages', button(Keys.KEY_Q))))"
        },
        "BACK": {
            "action": "hold(name('Spycam', button(Keys.KEY_O)), name('Co-op Spy', button(Keys.KEY_F12)))"
        },
        "C": {
            "action": "hold(menu('Default.menu'), menu('Default.menu'))"
        },
        "CPADPRESS": {
            "action": "hold(button(Keys.KEY_H), button(Keys.KEY_N), 0.5)"
        },
        "LB": {
            "action": "name('Modeshift', None)",
            "name": "Modeshift"
        },
        "LGRIP": {
            "action": "mode(LT, name('Drop One (Hold LTrig)', button(Keys.KEY_SEMICOLON)), name('Lean Left', button(Keys.KEY_LEFTBRACE)))"
        },
        "RB": {
            "action": "button(Keys.BTN_MOUSE)"
        },
        "RGRIP": {
            "action": "mode(LT, name('Use/Pick Up (Hold LTrig)', button(Keys.KEY_BACKSPACE)), name('Lean Right', button(Keys.KEY_RIGHTBRACE)))"
        },
        "RPAD": {
            "action": "mode(LB, name('Crouch', button(Keys.KEY_C)), button(Keys.KEY_SPACE))"
        },
        "RSTICKPRESS": {
            "action": "mode(LB, name('Crouch', button(Keys.KEY_C)), button(Keys.KEY_SPACE))"
        },
        "START": {
            "action": "hold(name('Map (Hold)', button(Keys.KEY_TAB)), button(Keys.KEY_ESC))"
        },
        "STICKPRESS": {
            "action": "button(Keys.KEY_LEFTSHIFT)",
            "name": "Sprint"
        },
        "X": {
            "action": "hold(mode(LB, name('Lean Left', button(Keys.KEY_LEFTBRACE)), name('Drop Armor (Hold)', button(Keys.KEY_APOSTROPHE))), mode(LB, name('Cycle Inv. Left (LB)', button(Keys.KEY_LEFT)), name('Drop Weapon', button(Keys.KEY_Z))))"
        },
        "Y": {
            "action": "mode(LB, name('Unload', button(Keys.KEY_V)), RT >= 0.01, name('Reload (Chamber)', button(Keys.KEY_T)), name('Use/Take', button(Keys.KEY_BACKSPACE)))"
        }
    },
    "cpad": {},
    "dpad": {},
    "gyro": {
        "action": "mode(A, None, sens(4.0, -2.6, 3.5, mouse(YAW)))"
    },
