    "pad_left": {
        "action": "dpad(1, doubleclick(menu('Misc'), hold(name('Save Replay', shell('obs-cli -P 4444 -p nT2ClupGclzeR3ZF replay save')), mode(LB, name('Mousewheel Up', mouse(Rels.REL_WHEEL, 1)), name('Rangefinder', button(Keys.KEY_R))))), hold(mode(LB, name('Mag Manager', button(Keys.KEY_B)), name('Unload', button(Keys.KEY_V))), mode(LB, mouse(Rels.REL_WHEEL, -1), name('Unload', button(Keys.KEY_V)))), mode(LB, name('Drop One (LB)', button(Keys.KEY_SEMICOLON)), A, name('Reduce Music', button(Keys.KEY_BACKSLASH)), name('Drop Item', button(Keys.KEY_X))), hold(name('Start Recording', shell('obs-cli -P 4444 -p nT2ClupGclzeR3ZF record toggle')), mode(LB, name('Grenades (LB)', button(Keys.KEY_G)), A, name('Raise Music', button(Keys.KEY_MINUS)), name('Cycle Medical', button(Keys.KEY_9)))))"
    },
    "pad_right": {
        "action": "mode(LB, deadzone(ROUND, 31070, dpad8(hold(button(Keys.KEY_5), button(Keys.KEY_1)), hold(button(Keys.KEY_7), button(Keys.KEY_3)), hold(button(Keys.KEY_8), button(Keys.KEY_4)), hold(button(Keys.KEY_6), button(Keys.KEY_2)), button(Keys.KEY_DOT), button(Keys.KEY_L), button(Keys.KEY_COMMA))), deadzone(LINEAR, 32039, smooth(20, 0.8, 18, sens(8.0, 8.0, circular(mouse(Rels.REL_X, 1))))))"
    },
    "rstick": {
        "action": "mode(LB, dpad8(hold(button(Keys.KEY_5), button(Keys.KEY_1)), hold(button(Keys.KEY_7), button(Keys.KEY_3)), hold(button(Keys.KEY_8), button(Keys.KEY_4)), hold(button(Keys.KEY_6), button(Keys.KEY_2)), None, button(Keys.KEY_L), None, button(Keys.KEY_O)), sens(9.0, 9.0, circular(mouse(Rels.REL_X, 1))))"
    },
    "stick": {
        "action": "deadzone(ROUND, 4118, dpad(axis(Axes.ABS_Y, 0, -32767), axis(Axes.ABS_Y, 0, 32767), axis(Axes.ABS_X, 0, -32767), axis(Axes.ABS_X, 0, 32767))) and ring(0.8, button(Keys.KEY_A))"
    },
    "trigger_left": {
        "action": "feedback(LEFT, 3090, hipfire(1, 254, button(Keys.BTN_RIGHT), button(Keys.KEY_EQUAL), EXCLUSIVE, 0.05))"
    },
    "trigger_right": {
        "action": "mode(LB, hipfire(1, 254, button(Keys.KEY_T), button(Keys.KEY_END), EXCLUSIVE, 0.02), button(Keys.BTN_MIDDLE))"
