<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.1.0 -->
<interface>
  <!-- interface-name macro_editor.glade -->
  <requires lib="gtk" version="4.14"/>
  <object class="GtkListStore" id="lstMacroType">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">macro</col>
        <col id="1" translatable="yes">Run once</col>
      </row>
      <row>
        <col id="0">repeat</col>
        <col id="1" translatable="yes">Repeat</col>
      </row>
      <row>
        <col id="0">cycle</col>
        <col id="1" translatable="yes">Cycle</col>
      </row>
    </data>
  </object>
  <object class="GtkWindow" id="Dialog">
    <property name="child">
      <object class="GtkGrid" id="grid1">
        <property name="margin-bottom">10</property>
        <property name="margin-end">10</property>
        <property name="margin-start">10</property>
        <property name="margin-top">10</property>
        <child>
          <object class="GtkLabel" id="lblName">
            <property name="attributes">
              0 -1 weight bold
            </property>
            <property name="ellipsize">end</property>
            <property name="label" translatable="yes">Action Name</property>
            <property name="margin-bottom">4</property>
            <property name="margin-end">20</property>
            <property name="xalign">0</property>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="entName">
            <property name="activates-default">1</property>
            <property name="focusable">1</property>
            <property name="margin-bottom">2</property>
            <layout>
              <property name="column">1</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label2">
            <property name="attributes">
              0 -1 weight bold
            </property>
            <property name="ellipsize">end</property>
            <property name="label" translatable="yes">Macro Type</property>
            <property name="margin-bottom">4</property>
            <property name="margin-end">20</property>
            <property name="xalign">0</property>
            <layout>
              <property name="column">0</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkComboBox" id="cbMacroType">
            <property name="active">0</property>
            <property name="model">lstMacroType</property>
            <signal name="changed" handler="on_cbMacroType_changed"/>
            <child>
              <object class="GtkCellRendererText" id="cellrenderertext1"/>
              <!-- Custom child fragments -->
              <attributes>
                <attribute name="text">1</attribute>
              </attributes>
            </child>
            <layout>
              <property name="column">1</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="grActions">
            <property name="row-homogeneous">1</property>
            <property name="row-spacing">5</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">2</property>
              <property name="row">4</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCenterBox" id="box1">
            <property name="end-widget">
              <object class="GtkBox">
                <child>
                  <object class="GtkButton" id="btAddDelay">
                    <property name="focusable">1</property>
                    <property name="label" translatable="yes">Add Delay</property>
                    <property name="receives-default">1</property>
                    <signal name="clicked" handler="on_btAddDelay_clicked"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btAddAction">
                    <property name="focusable">1</property>
                    <property name="label" translatable="yes">Add _Action</property>
                    <property name="margin-start">5</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                    <signal name="clicked" handler="on_btAddAction_clicked"/>
                  </object>
                </child>
              </object>
            </property>
            <property name="margin-top">10</property>
            <property name="start-widget">
              <object class="GtkBox">
                <child>
                  <object class="GtkEntry" id="entAction">
                    <property name="activates-default">1</property>
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="margin-end">10</property>
                  </object>
                </child>
              </object>
            </property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">2</property>
              <property name="row">6</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label3">
            <property name="vexpand">1</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">2</property>
              <property name="row">5</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="separator1">
            <property name="margin-bottom">10</property>
            <property name="margin-top">2</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">2</property>
              <property name="row">3</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="lblAddedWidget">
            <property name="attributes">
              0 -1 weight bold
            </property>
            <property name="label" translatable="yes">(Widget)</property>
            <property name="margin-bottom">5</property>
            <property name="margin-end">20</property>
            <property name="visible">0</property>
            <property name="xalign">0</property>
            <property name="yalign">0</property>
            <layout>
              <property name="column">0</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbAddedWidget">
            <property name="hexpand">1</property>
            <property name="margin-bottom">5</property>
            <property name="orientation">vertical</property>
            <property name="visible">0</property>
            <layout>
              <property name="column">1</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
      </object>
    </property>
    <property name="default-widget">btOK</property>
    <property name="destroy-with-parent">1</property>
    <property name="resizable">0</property>
    <property name="titlebar">
      <object class="GtkHeaderBar" id="header">
        <child>
          <object class="GtkButton" id="btCustomActionEditor">
            <property name="focusable">1</property>
            <property name="label" translatable="yes">Custom Editor</property>
            <property name="receives-default">1</property>
            <signal name="clicked" handler="on_btCustomActionEditor_clicked"/>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="btClear">
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage" id="imgClear">
                    <property name="icon-name">edit-clear-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">_Clear</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <signal name="clicked" handler="on_btClear_clicked"/>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="btOK">
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage" id="imgOK">
                    <property name="icon-name">emblem-ok-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">_OK</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <signal name="clicked" handler="on_btOK_clicked"/>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </property>
    <property name="width-request">600</property>
    <signal name="destroy" handler="on_Dialog_destroy"/>
    <child>
      <object class="GtkEventControllerKey">
        <signal name="key-pressed" handler="on_window_key_press_event"/>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="lstPressClickOrHold">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">button</col>
        <col id="1" translatable="yes">Click</col>
      </row>
      <row>
        <col id="0">press</col>
        <col id="1" translatable="yes">Press</col>
      </row>
      <row>
        <col id="0">release</col>
        <col id="1" translatable="yes">Release</col>
      </row>
    </data>
  </object>
</interface>
