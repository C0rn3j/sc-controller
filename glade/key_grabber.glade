<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="KeyGrab">
    <property name="resizable">0</property>
    <property name="destroy-with-parent">1</property>
    <signal name="destroy" handler="on_KeyGrab_destroy" swapped="no"/>
    <child>
      <object class="GtkEventControllerKey">
        <signal name="key-pressed" handler="on_keyGrab_key_press_event" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkEventControllerKey">
        <signal name="key-released" handler="on_keyGrab_key_release_event" swapped="no"/>
      </object>
    </child>
    <property name="child">
      <object class="GtkGrid" id="grid2">
        <property name="margin-start">30</property>
        <property name="margin-end">30</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        <property name="row-spacing">3</property>
        <property name="column-spacing">3</property>
        <child>
          <object class="GtkToggleButton" id="tgKEY_LEFTCTRL">
            <property name="label" translatable="yes">Ctrl</property>
            <property name="width-request">90</property>
            <property name="receives-default">1</property>
            <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="tgKEY_LEFTMETA">
            <property name="label" translatable="yes">Meta</property>
            <property name="receives-default">1</property>
            <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
            <layout>
              <property name="column">1</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="tgKEY_LEFTALT">
            <property name="label" translatable="yes">Alt</property>
            <property name="width-request">80</property>
            <property name="receives-default">1</property>
            <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
            <layout>
              <property name="column">2</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label6">
            <property name="width-request">100</property>
            <property name="hexpand">1</property>
            <property name="label" translatable="yes"> </property>
            <layout>
              <property name="column">3</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="tgKEY_RIGHTALT">
            <property name="label" translatable="yes">Alt</property>
            <property name="width-request">80</property>
            <property name="receives-default">1</property>
            <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
            <layout>
              <property name="column">4</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="tgKEY_RIGHTMETA">
            <property name="label" translatable="yes">Meta</property>
            <property name="receives-default">1</property>
            <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
            <layout>
              <property name="column">5</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="tgKEY_RIGHTCTRL">
            <property name="label" translatable="yes">Ctrl</property>
            <property name="width-request">90</property>
            <property name="receives-default">1</property>
            <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
            <layout>
              <property name="column">6</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box1">
            <layout>
              <property name="column">0</property>
              <property name="row">0</property>
              <property name="column-span">2</property>
            </layout>
            <child>
              <object class="GtkToggleButton" id="tgKEY_LEFTSHIFT">
                <property name="label" translatable="yes">Shift</property>
                <property name="width-request">140</property>
                <property name="receives-default">1</property>
                <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label5">
                <property name="hexpand">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box2">
            <layout>
              <property name="column">5</property>
              <property name="row">0</property>
              <property name="column-span">2</property>
            </layout>
            <child>
              <object class="GtkLabel" id="label8">
                <property name="hexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="tgKEY_RIGHTSHIFT">
                <property name="label" translatable="yes">Shift</property>
                <property name="width-request">140</property>
                <property name="receives-default">1</property>
                <signal name="toggled" handler="on_tgkey_toggled" swapped="no"/>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="lblKey">
            <property name="focusable">1</property>
            <property name="label" translatable="yes">(...)</property>
            <layout>
              <property name="column">2</property>
              <property name="row">0</property>
              <property name="column-span">3</property>
            </layout>
          </object>
        </child>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
        <child>
          <placeholder/>
        </child>
      </object>
    </property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="headerbar1">
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">Press a Key...</property>
            <style>
              <class name="title"/>
            </style>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
