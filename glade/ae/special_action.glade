                      <property name="column">0</property>
                      <property name="column-span">2</property>
                      <property name="row">5</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkExpander" id="exMenuPosition">
                    <property name="focusable">1</property>
                    <property name="label-widget">
                      <object class="GtkLabel" id="label8">
                        <property name="attributes">
                          0 -1 weight bold
                        </property>
                        <property name="label" translatable="yes">Menu Position...</property>
                      </object>
                    </property>
                    <property name="margin-top">10</property>
                    <signal name="activate" handler="on_exMenuPosition_activate"/>
                    <layout>
                      <property name="column">0</property>
                      <property name="column-span">2</property>
                      <property name="row">6</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkRevealer" id="rvMenuPosition">
                    <property name="child">
                      <object class="GtkGrid" id="grid7">
                        <property name="margin-bottom">10</property>
                        <property name="margin-end">20</property>
                        <property name="margin-start">20</property>
                        <property name="margin-top">5</property>
                        <child>
                          <object class="GtkSpinButton" id="spMenuPosX">
                            <property name="adjustment">adjMenuPosX</property>
                            <property name="focusable">1</property>
                            <property name="hexpand">1</property>
                            <signal name="value-changed" handler="on_cbMenus_changed"/>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="spMenuPosY">
                            <property name="adjustment">adjMenuPosY</property>
                            <property name="focusable">1</property>
                            <property name="hexpand">1</property>
                            <property name="margin-top">5</property>
                            <signal name="value-changed" handler="on_cbMenus_changed"/>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkComboBox" id="cbMenuPosX">
                            <property name="active">0</property>
                            <property name="margin-start">20</property>
                            <property name="model">lstMenuPosX</property>
                            <property name="width-request">200</property>
                            <signal name="changed" handler="on_cbMenus_changed"/>
                            <child>
                              <object class="GtkCellRendererText" id="crMenuPosX"/>
                              <!-- Custom child fragments -->
                              <attributes>
                                <attribute name="text">1</attribute>
                              </attributes>
                            </child>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkComboBox" id="cbMenuPosY">
                            <property name="active">1</property>
                            <property name="margin-start">20</property>
                            <property name="margin-top">5</property>
                            <property name="model">lstMenuPosY</property>
                            <property name="width-request">200</property>
                            <signal name="changed" handler="on_cbMenus_changed"/>
                            <child>
                              <object class="GtkCellRendererText" id="crMenuPosY"/>
                              <!-- Custom child fragments -->
                              <attributes>
                                <attribute name="text">1</attribute>
                              </attributes>
                            </child>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                    <layout>
                      <property name="column">0</property>
                      <property name="column-span">2</property>
                      <property name="row">7</property>
                    </layout>
                  </object>
                </child>
              </object>
            </property>
            <property name="name">page1</property>
            <property name="title" translatable="yes">page1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkPopover" id="mnuMenu">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkButton" id="mnuMenuNew">
            <property name="label" translatable="yes">_New Menu</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="on_mnuMenuNew_activate"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="mnuMenuCopy">
            <property name="label" translatable="yes">_Copy Menu</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="on_mnuMenuCopy_activate"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="mnuMenuRename">
            <property name="label" translatable="yes">_Rename Menu</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="on_mnuMenuRename_activate"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="mnuMenuDelete">
            <property name="label" translatable="yes">_Delete Menu</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="on_mnuMenuDelete_activate"/>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
